{
  "openapi": "3.1.0",
  "info": {
    "title": "FOUR Score API",
    "version": "3.1.0",
    "description": "Clinical FOUR scoring and independent legacy demonstration endpoints. Runtime /openapi.json is authoritative."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Application health",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Process-local counters",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/four-score": {
      "post": {
        "summary": "Compute FOUR score (0–16)",
        "description": "Adds eye, motor, brainstem and respiration points (integers 0–4 each). No prognostic cutoffs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FourScoreRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "FOUR total and components"
          },
          "422": {
            "description": "Input validation error"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "deprecated": true,
        "summary": "Legacy generic workflow demonstration (not FOUR scoring)",
        "responses": {
          "200": {
            "description": "Demo dossier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "deprecated": true,
        "summary": "Deterministic mock response",
        "responses": {
          "200": {
            "description": "Mock response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "deprecated": true,
        "summary": "Process-local demo audit metadata",
        "responses": {
          "200": {
            "description": "Demo audit chain"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FourScoreRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eye",
          "motor",
          "brainstem",
          "respiration"
        ],
        "properties": {
          "eye": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "motor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "brainstem": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "respiration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        }
      }
    }
  }
}
